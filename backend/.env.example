PORT=5000
NODE_ENV=production

# ─── REQUIRED SECRETS ────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -base64 48
# Server will refuse to start without this.
JWT_SECRET=use-a-secure-long-random-string-here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/rasick-ex?retryWrites=true&w=majority

# Filebase S3 Object Storage credentials
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_BUCKET=rasick-music
FILEBASE_ACCESS_KEY=your-filebase-access-key-here
FILEBASE_SECRET_KEY=your-filebase-secret-key-here

# ─── Seed user credentials (first run only — set strong passwords) ───────────
SEED_ADMIN_USERNAME=RASICKEX
SEED_ADMIN_PASSWORD=set-a-strong-admin-password-here
SEED_USER_USERNAME=RASICKEX2026
SEED_USER_PASSWORD=set-a-strong-user-password-here

# ─── CORS — comma-separated allowed origins ─────────────────────────────────
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://your-admin-web-domain.com

# ─── Optional settings ──────────────────────────────────────────────────────
UPLOAD_TEMP_DIR=/opt/rasick/uploads/temp
MAX_UPLOAD_SIZE=52428800
